#!/bin/bash
# {{ ansible_managed }}
#
# Bring up / update the FOU (IP-IP over UDP) tunnels of this node, one per peer.
# Run at boot by overlay.service and by overlay-network.yml after a VM restart.
#
# Each peer's remote IP comes from its CrownLabs DNS name; if that does not
# resolve (e.g. the peer VM is off) the IP recorded by the last Ansible run is
# used, so the overlay address always exists and k3s can start.
set -uo pipefail

SELF_OVERLAY={{ overlay_ip }}
FOU_PORT={{ overlay_fou_port }}

# name  dns-name  overlay-ip  last-known-ip
PEERS="
{% for p in overlay_dns.results %}
{{ p.item }} {{ hostvars[p.item].ansible_host }}.{{ crownlabs_dns_suffix }} {{ hostvars[p.item].overlay_ip }} {{ p.stdout_lines[0].split()[0] }}
{% endfor %}
"

modprobe fou
modprobe ipip
ip fou show | grep -q "port $FOU_PORT " || ip fou add port "$FOU_PORT" ipproto 4

while read -r name fqdn overlay fallback; do
  [ -z "$name" ] && continue
  remote=$(getent ahostsv4 "$fqdn" | awk 'NR==1{print $1}')
  if [ -z "$remote" ]; then
    echo "$name: cannot resolve $fqdn, using last known IP $fallback"
    remote=$fallback
  fi
  dev="ovl-$name"
  encap=(encap fou encap-sport auto encap-dport "$FOU_PORT")

  if ! ip link show "$dev" &>/dev/null; then
    ip link add "$dev" type ipip remote "$remote" "${encap[@]}"   # no 'local': our own IP changes too
    echo "$name: changed, created tunnel to $remote"
  else
    current=$(ip -d link show "$dev" | grep -oP 'peer \K[0-9.]+')
    if [ "$current" != "$remote" ]; then
      ip link set "$dev" type ipip remote "$remote" "${encap[@]}"
      echo "$name: changed, remote $current -> $remote"
    fi
  fi
  ip addr replace "$SELF_OVERLAY/32" peer "$overlay/32" dev "$dev"
  ip link set "$dev" up
done <<< "$PEERS"
