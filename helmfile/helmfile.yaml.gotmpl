# JuiceFS on the k3s cluster (KubeVirt/CDI are installed with kubectl, see ../COMMANDS.md):
#   - cloudnative-pg      CloudNativePG operator
#   - juicefs-meta        PostgreSQL cluster (3 instances, local-path) = JuiceFS metadata engine
#   - juicefs-csi-driver  JuiceFS CSI driver + juicefs-sc StorageClass
#   - rustfs              distributed S3 object storage (3 pods x 1 local-path drive)
# JuiceFS stores its data in RustFS (settings in backend.yaml).
#
#   cp backend.example.yaml backend.yaml   # then fill in the passwords + keys
#   helmfile diff
#   helmfile apply

environments:
  default:
    values:
      - backend.yaml

---
repositories:
  - name: juicefs
    url: https://juicedata.github.io/charts/
  - name: cnpg
    url: https://cloudnative-pg.github.io/charts
  - name: rustfs
    url: https://charts.rustfs.com

releases:
  - name: cloudnative-pg
    namespace: cnpg-system
    chart: cnpg/cloudnative-pg
    version: 0.29.1
    # Wait for the operator to be ready: its webhook must answer before the
    # juicefs-meta Cluster can be created.
    wait: true

  - name: juicefs-meta
    namespace: juicefs
    chart: ./charts/juicefs-meta
    # The Cluster CRD comes from the operator chart.
    needs:
      - cnpg-system/cloudnative-pg
    disableValidationOnInstall: true
    values:
      - password: {{ .Values.juicefs.meta.password | quote }}
        guestPassword: {{ .Values.juicefsGuest.meta.password | quote }}

  - name: juicefs-csi-driver
    namespace: kube-system
    chart: juicefs/juicefs-csi-driver
    version: 0.33.3
    # rustfs: JuiceFS's S3 backend (when backend.yaml points at it). The
    # bucket needs no manual step: `juicefs format`, run by the driver for the
    # first volume, creates it if it does not exist.
    needs:
      - juicefs/juicefs-meta
      - rustfs/rustfs
    values:
      - values/juicefs-csi-driver.yaml.gotmpl

  - name: rustfs
    namespace: rustfs
    chart: rustfs/rustfs
    version: 1.0.6
    # Wait for all 3 pods to be Ready before installing what depends on it.
    wait: true
    timeout: 600
    values:
      - values/rustfs.yaml.gotmpl
